# Copy to .env and fill in values

# PostgreSQL connection (async driver)
# For Saudi Arabia deployment: run this on a VM or RDS instance in me-south-1 (Bahrain).
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/tradeflow

# AWS / DynamoDB
# DATA RESIDENCY: must be me-south-1 (Bahrain) or me-central-1 (UAE) for
# Saudi Arabia / GCC deployments.  Do NOT use eu-* or us-* regions.
AWS_REGION=me-south-1
DYNAMODB_TABLE_NAME=Shipments
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# JWT auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-production

# Exception engine thresholds (optional — these are the defaults)
WEIGHT_DISCREPANCY_THRESHOLD_PCT=2.0
VALUE_DISCREPANCY_THRESHOLD_PCT=5.0
CERT_EXPIRY_WARNING_DAYS=7

# WhatsApp notifications via Twilio
# 1. Create a free Twilio account at https://www.twilio.com/
# 2. Enable the WhatsApp sandbox (testing) or request a production sender.
# 3. Fill in the three values below.  Leave blank to disable notifications.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio WhatsApp-enabled number in E.164 format, e.g. +14155238886
TWILIO_WHATSAPP_FROM=

# Debug (set False in production)
DEBUG=False
